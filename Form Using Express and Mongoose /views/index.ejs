<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="w-full h-full bg-zinc-900 text-white p-10">
        <div class="nav mb-10">
            <a href="/read" class="text-blue-300">Read Users</a>
        </div>
        <h1 class="text-3xl trackin-tighter mb-5">Create User</h1>
        <form action="/create" method="post">
            <input type="text" name="name" class="px-5 py-2 border-2 border-zinc-700 rounded-lg outline-none bg-transparent" placeholder="Name">
            <input type="text" name="email" class="px-5 py-2 border-2 border-zinc-700 rounded-lg outline-none bg-transparent" placeholder="Email">
            <input type="text" name="image" class="px-5 py-2 border-2 border-zinc-700 rounded-lg outline-none bg-transparent" placeholder="Image URL">
            <input type="submit" value="Create User" class="px-5 py-2 bg-blue-500 rounded-lg ml-3">
        </form>
    </div>
</body>
</html>