<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="w-full h-full bg-zinc-900 text-white p-10">
        <a href="/" class="text-blue-300">Go Back to Create User</a>
        <h1 class="text-3xl trackin-tighter mt-10 mb-5">All Users</h1>
        <div class="users flex flex-wrap gap-5">
            <% if(users.length > 0){ %>
                <% users.forEach(function(user){ %>
                    <div class="user w-72 p-5 bg-zinc-700 rounded-lg ">
                    <div class="w-full h-52 rounded-lg bg-zinc-500 overflow-hidden">
                        <img class="w-full h-full object-cover" src="<%= user.image %>" alt="">
                    </div>
                    <h3 class="text-xl trackin-tighter mt-3"><%= user.name %></h3>
                    <h5 class="text-zinc-400"><%= user.email %></h5>
                    <div class="flex gap-3 mt-10">
                        <a class="text-blue-300" href="/edit/<%= user._id %>">Edit User</a>
                        <a class="text-red-300" href="/delete/<%= user._id %>">Delete User</a>
                    </div>
                </div>
                <% })%>
           <% }else{ %>
                <h3 class="text-zinc-400">No users yet.</h3>
           <% } %>
        </div>
    </div>
</body>
</html>