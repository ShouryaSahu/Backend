<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-2 inline-block text-sm" href="/logout">Logout</a>
        </div>
        <h5 class="mb-10">Edit your post.</h5>
        <form action="/update/<%= post._id %>" method="post">
            <textarea name="content" class="block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-700 rounded-md mb-4" placeholder="What's on your mind?"> <%= post.content %> </textarea>
            <textarea name="update" class="block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-700 rounded-md mb-4" placeholder="Update your post!"></textarea>
            <input type="submit" class="block px-3 w-40 py-2 bg-yellow-500 text-black rounded-md" value="Update post">
        </form>

        
    </div>
</body>
</html>